# Optional live test with OpenRouter's free-model router. This requires an OpenRouter API key.
# Keep real keys in environment / Codespaces Secrets; never commit them.
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace_with_your_own_openrouter_key
LLM_MODEL=openrouter/free
# Optional metadata for OpenRouter request logs
OPENROUTER_SITE_URL=https://localhost/itxn-credit-case-study
OPENROUTER_APP_NAME=ITXN Credit Case Study
